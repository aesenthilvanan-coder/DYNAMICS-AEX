# API mode
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://caly360:password@localhost:5432/caly360
# Persist job metadata and DYNAMICS results
ENABLE_DATABASE=false

# Dynamics paths
LOCAL_UPLOAD_ROOT=/tmp/caly360_uploads
DYNAMICS_OUTPUT_ROOT=/tmp/caly360_md

# Object storage
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=caly360
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Optional API auth
API_KEY=

# Metrics
ENABLE_METRICS=false

# GROMACS
GROMACS_BIN=gmx

# GPU
CUDA_VISIBLE_DEVICES=0
